          report.yearlyInterestRate = 0.081;
        }
        case (loan != null && [0.7,0.8[.contains(loan.loanToValue)) : then 22{
          report.yearlyInterestRate = 0.082;
        }
        case (loan != null && [0.8,0.9[.contains(loan.loanToValue)) : then 23{
