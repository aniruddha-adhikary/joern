        updateGenerators;
      }
      case (borrower != null && [80000,120000[.contains(borrower.yearlyIncome)) : then 6{
        score = Integer.valueOf((int)(score.intValue() + 200));
        updateEngineData;
        updateGenerators;
      }
      case (borrower != null && [120000,200000[.contains(borrower.yearlyIncome)) : then 7{
        score = Integer.valueOf((int)(score.intValue() + 250));
        updateEngineData;
        updateGenerators;
      }
      case (borrower != null && borrower.yearlyIncome >= 200000) : then 8{
        score = Integer.valueOf((int)(score.intValue() + 300));
        updateEngineData;
        updateGenerators;
      }
