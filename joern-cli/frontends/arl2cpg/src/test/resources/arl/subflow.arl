  ordering : SORTED;
  criteria : ALL_RULES;
  rules : computation.*;
}
ruletask `probe modes>t_Fastpath_Default_Rule`(fastpath){
  ordering : SORTED;
  criteria : FIRST_ELIGIBLE_RULE;
