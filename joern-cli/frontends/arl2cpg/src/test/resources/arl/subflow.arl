    when {
      Borrower() from borrower;
      evaluate ( ! borrower.hasLatestBankrupcy());
    }
    then {
      score = Integer.valueOf((int)(score.intValue() + 20));
      updateEngineData;
      updateGenerators;
    }
  }
  
