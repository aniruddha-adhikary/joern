  rule `computation.repayment` {
    property priority = -1000000;
    ilog.rules.business_name = "repayment"
    ilog.rules.dt = ""
    ilog.rules.package_name = "computation"
    status = "deployable"
    when {
      Report() from report;
      LoanRequest() from loan;
      evaluate ( amount : loan.amount);
      evaluate ( duration : loan.numberOfMonthlyPayments);
      evaluate ( rate : report.yearlyInterestRate);
    }
    then {
      report.monthlyRepayment = LoanUtil.getMonthlyRepayment((double)amount, duration, rate);
      System.printMessage("monthly repayment calculated.");
    }
  }
  
  rule `computation.salary2score` {
    ilog.rules.business_name = "salary2score"
    ilog.rules.dt = "computation.salary2score"
