public signature EngineDataClass extends com.ibm.rules.engine.runtime.impl.AbstractEngineData {
  public in Borrower borrower = null;
  public out String grade = "";
  public in LoanRequest loan = null;
  public out Report report = null;
  public out Integer score = null;
}

ruleset IlrContext (EngineDataClass){
  
  rule `computation.bankruptcyScore` {
    ilog.rules.business_name = "bankruptcyScore"
    ilog.rules.dt = "computation.bankruptcyScore"
    ilog.rules.package_name = "computation"
    status = "new"
    when {
      Borrower() from borrower;
      evaluate ( borrower.hasLatestBankrupcy());
    }
    match many {
      case ([0,1].contains(borrower.getBankruptcyAge())) : then 1{
        score = Integer.valueOf((int)(score.intValue() + -200));
        updateEngineData;
        updateGenerators;
      }
      case ([2,5].contains(borrower.getBankruptcyAge())) : then 2{
        score = Integer.valueOf((int)(score.intValue() + -100));
        updateEngineData;
        updateGenerators;
      }
      case ([6,8].contains(borrower.getBankruptcyAge())) : then 3{
        score = Integer.valueOf((int)(score.intValue() + -50));
        updateEngineData;
        updateGenerators;
      }
      default : then 4{
        score = Integer.valueOf((int)(score.intValue() + -10));
        updateEngineData;
        updateGenerators;
      }
    }
  }
  
  rule `computation.initialCorporateScore` {
    property priority = 1000000;
    ilog.rules.business_name = "initialCorporateScore"
    ilog.rules.dt = ""
    ilog.rules.package_name = "computation"
    status = "new"
    then {
      score = Integer.valueOf((int)borrower.creditScore);
      updateEngineData;
      updateGenerators;
    }
  }
  
  rule `computation.neverBankruptcy` {
    ilog.rules.business_name = "neverBankruptcy"
    ilog.rules.dt = ""
