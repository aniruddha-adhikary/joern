flowtask `probe select`($EngineData){
  {
    call task : probe select>init;
    call task : probe select>dyn;
  }
}
ruletask `probe select>dyn`(rete){
  ordering : DYNAMIC;
  criteria : ALL_RULES;
  rules : computation.*;
  select (Rule `rule`) {
    return ((String)`rule`.properties.get("ruleExecutionName")).contains("score");
  }
}
functiontask `probe select>init`{
  {
    $EngineData.this.report = new Report($EngineData.this.borrower, $EngineData.this.loan);
    $EngineData.this.report.approved = true;
  }
}
flowtask `probe subflow`($EngineData){
  {
    call task : probe subflow>init;
    call task : probe subflow>sub;
  }
}
functiontask `probe subflow>init`{
  {
    $EngineData.this.report = new Report($EngineData.this.borrower, $EngineData.this.loan);
    $EngineData.this.report.approved = true;
  }
}
flowtask `probe subflow>sub`($EngineData){
  {
    call task : eligibilityFlow;
  }
}
